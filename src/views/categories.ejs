<%- include('partials/header') %>
<main id="main-content">
  <header class="page-intro">
    <p class="eyebrow">Find a cause</p>
    <h1><%= title %></h1>
    <p class="lead">Browse service project categories retrieved from the database.</p>
  </header>
  <% if (categories.length === 0) { %>
    <p>No categories are available yet.</p>
  <% } else { %>
    <ul class="card-grid">
      <% categories.forEach((category) => { %>
        <li class="card"><h2><%= category.category_name %></h2></li>
      <% }); %>
    </ul>
  <% } %>
</main>
<%- include('partials/footer') %>
