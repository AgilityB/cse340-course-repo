<%- include('partials/header') %>
<main id="main-content">
  <header class="page-intro">
    <p class="eyebrow">Opportunities to serve</p>
    <h1><%= title %></h1>
    <p class="lead">Upcoming service projects retrieved from the database.</p>
  </header>
  <% if (projects.length === 0) { %>
    <p>No service projects are available yet.</p>
  <% } else { %>
    <ul class="card-grid">
      <% projects.forEach((project) => { %>
        <li class="card">
          <h2><%= project.title %></h2>
          <p><%= project.description %></p>
          <p><strong>Organization:</strong> <%= project.organization_name %></p>
          <p><strong>Location:</strong> <%= project.location %></p>
          <p><strong>Categories:</strong> <%= project.categories %></p>
          <p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
        </li>
      <% }); %>
    </ul>
  <% } %>
</main>
<%- include('partials/footer') %>
